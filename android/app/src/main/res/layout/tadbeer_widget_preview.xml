<?xml version="1.0" encoding="utf-8"?>
<!-- The widget as the picker shows it: the same glass, a sample ayah in the
     Quranic font, and the khatma section filled with sample values. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_glass_navy" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:src="@drawable/widget_edge" />

<LinearLayout
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Header: title and the reflect button. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_sample_title"
            android:textAlignment="viewStart"
            android:textColor="#E2C27A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_reflect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_glass"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="@string/widget_sample_reflect"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- The ayah, drawn by the app in the Quranic font; plain text until
         the image exists. -->
    <FrameLayout
        android:id="@+id/widget_ayah_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/widget_ayah"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/amiri_quran"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:shadowColor="#66000000"
            android:shadowRadius="6"
            android:text="@string/widget_sample_ayah"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_ref"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/widget_sample_ref"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp" />

    <!-- Khatma: ornament, progress ring, today's portion and read button. -->
    <LinearLayout
        android:id="@+id/widget_khatma"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_ornament" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp">

                <ProgressBar
                    android:id="@+id/widget_progress"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="100"
                    android:progress="40"
                    android:progressDrawable="@drawable/widget_progress" />

                <TextView
                    android:id="@+id/widget_khatma_percent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/widget_sample_percent"
                    android:textColor="#E2C27A"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_khatma_title"
                    android:text="@string/widget_sample_khatma"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_portion"
                    android:text="@string/widget_sample_portion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:textAlignment="viewStart"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_read"
                android:text="@string/widget_sample_read"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_gold"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:textColor="#14273F"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
